# ---- Backend ----
NODE_ENV=development
PORT=3000

# Public origin of the frontend. Drives the CORS allowlist (app.config.ts).
APP_URL=http://localhost:5173

# Signing key for the access token. Minimum 32 characters — Joi refuses to boot
# below that. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-32-character-minimum-secret
JWT_EXPIRES_IN=7d

# How many reverse-proxy hops sit in front of the app. Production behind a host
# TLS terminator plus the bundled nginx is 2. Trusting more hops than actually
# exist lets a client spoof X-Forwarded-For and bypass per-IP rate limiting.
TRUST_PROXY_HOPS=0

DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app
# Managed Postgres (Neon/RDS/Supabase/…) requires TLS.
DB_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6379

APP_TIMEZONE=Europe/Kyiv

# Where uploaded images are written. Defaults to <cwd>/uploads.
# UPLOADS_DIR=/var/lib/web-starter/uploads

# Creates the first network_owner account. Read ONCE, by the BootstrapOwner
# migration, and ONLY when the users table is empty — a fresh production
# database, never a development one (SeedDevAdmin already covers that case).
# Update your own .env with real values before the first production boot;
# this file is not committed, so nothing else will set them for you.
# BOOTSTRAP_OWNER_LOGIN=owner
# BOOTSTRAP_OWNER_PASSWORD=change-me-to-a-real-password
# BOOTSTRAP_OWNER_FIRST_NAME=Network
# BOOTSTRAP_OWNER_LAST_NAME=Owner

# Lets the network owner READ an issued password back on «Користувачі»
# (GET /users/:id/password, owner-only and audited). 32 random bytes in base64:
#   openssl rand -base64 32
# Unset means the feature is OFF — passwords are hashed and nothing more, which
# is the safer default; set it only where the owner really must hand a password
# back to an operator. The key never enters the database, so a dump without it
# reveals nothing. ROTATING IT MAKES EVERY EXISTING COPY UNREADABLE (logins are
# unaffected — reissue the passwords you want visible again).
# PASSWORD_VAULT_KEY=

# ---- Frontend ----
# Absolute http(s) URL, or a path beginning with "/" when the frontend is
# served behind the same origin as the API (production nginx does this).
VITE_API_URL=http://localhost:3000

# Global rate limit, per IP. Defaults below are what the app uses when unset;
# the DB-backed HTTP test suites raise the limit for their own process only
# (see backend/src/testing/db-harness.ts).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- docker-compose.prod.yml only (Coolify sets these in its own env sets) ---
# Which image to run. Coolify supplies SOURCE_COMMIT and the compose file builds
# the tag as sha-$SOURCE_COMMIT; there is no usable default, so on the
# standalone path pass IMAGE_TAG explicitly or the image resolves to «:sha-».
#IMAGE_TAG=sha-<full commit>
#GHCR_REPO=webspirio/yagoda-starter
# Runs the one-shot demo seed. NEVER set this in a production env set — its
# absence is the only thing keeping demo data out of production.
#SEED_DEV_DATA=true
# Memory: defaults in the compose file are the tight preview profile;
# production raises them. Keep each heap cap well below its mem_limit.
#POSTGRES_MEM_LIMIT=768m
#BACKEND_MEM_LIMIT=768m
#BACKEND_HEAP_MB=576
#SEED_MEM_LIMIT=256m
#SEED_HEAP_MB=192
#REDIS_MEM_LIMIT=128m
#NGINX_MEM_LIMIT=64m
