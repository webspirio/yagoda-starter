# ---- Backend ----
NODE_ENV=development
PORT=3000

# Public origin of the frontend. Drives the CORS allowlist (app.config.ts).
APP_URL=http://localhost:5173

# Signing key for the access token. Minimum 32 characters — Joi refuses to boot
# below that. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-32-character-minimum-secret
JWT_EXPIRES_IN=7d

# How many reverse-proxy hops sit in front of the app. Production behind a host
# TLS terminator plus the bundled nginx is 2. Trusting more hops than actually
# exist lets a client spoof X-Forwarded-For and bypass per-IP rate limiting.
TRUST_PROXY_HOPS=0

DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app
# Managed Postgres (Neon/RDS/Supabase/…) requires TLS.
DB_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6379

APP_TIMEZONE=Europe/Kyiv

# Where uploaded images are written. Defaults to <cwd>/uploads.
# UPLOADS_DIR=/var/lib/web-starter/uploads

# Creates the first network_owner account. Read ONCE, by the BootstrapOwner
# migration, and ONLY when the users table is empty — a fresh production
# database, never a development one (SeedDevAdmin already covers that case).
# Update your own .env with real values before the first production boot;
# this file is not committed, so nothing else will set them for you.
# BOOTSTRAP_OWNER_LOGIN=owner
# BOOTSTRAP_OWNER_PASSWORD=change-me-to-a-real-password
# BOOTSTRAP_OWNER_FIRST_NAME=Network
# BOOTSTRAP_OWNER_LAST_NAME=Owner

# ---- Frontend ----
# Absolute http(s) URL, or a path beginning with "/" when the frontend is
# served behind the same origin as the API (production nginx does this).
VITE_API_URL=http://localhost:3000
