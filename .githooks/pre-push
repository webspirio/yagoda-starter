#!/bin/sh
# Local pre-push gate. NOT a replacement for CI — a cheaper place to find out.
#
# WHY THIS EXISTS, in one measurement: on 2026-09-15 the `verify` job took 11-20+ minutes
# per run, and the same rows on a laptop take seconds. `lint` is 0.13s here and 18.0s there;
# `test:db` is 20s here and MORE THAN 8 MINUTES there. Discovering a red row after a
# twenty-minute round trip, when forty seconds locally would have said the same thing, is
# the waste this hook removes.
#
# WHAT IT DOES NOT DO is replace the `verify` job. A hook can be skipped — `git push
# --no-verify` does it, and so does a fresh clone that never ran `npm install` — so CI stays
# the authoritative gate and keeps running EVERYTHING. That duplication is deliberate and is
# the standard answer to this problem: local runs for speed of feedback, CI runs for proof.
#
# WHICH ROWS, and why these:
#   excluded  smoke     it recreates the shared `backend` container and reseeds the dev
#                       database (see the row's own blindSpot). Acceptable as a CI step,
#                       not as a side effect of every `git push`.
#   excluded  docker    only means something as a cold build; warm it is ~2s and proves
#                       nothing new, cold it is ~33s and belongs in CI.
#   excluded  coverage  46s locally and its floors are deliberately CI-only (they read as 0
#                       here), so locally it can report but never gate.
#   excluded  audit     depends on an external advisory database that changes with nothing
#                       in this repo. A push must not fail because GitHub reclassified a
#                       severity an hour ago.
# Everything else runs. The list is an EXCLUSION on purpose: a check added later joins this
# gate automatically, so forgetting to update this file makes the gate wider, never narrower.
#
# `--no-skip` is deliberately absent. A laptop without Docker or Postgres SKIPS those rows
# and says so out loud; it does not block the push. CI is where a missing precondition is a
# failure.
set -eu

printf '\npre-push: local verify gate (skip with `git push --no-verify`)\n'

# The hook must not depend on the caller's shell: `node` may come from nvm/fnm and not be on
# a hook's PATH at all. .claude/hooks/node.sh already solves exactly this, using only shell
# built-ins, and pins the major from .nvmrc — so reuse it rather than growing a second copy.
ROOT=$(git rev-parse --show-toplevel)
if [ -x "$ROOT/.claude/hooks/node.sh" ]; then
  CLAUDE_PROJECT_DIR="$ROOT" "$ROOT/.claude/hooks/node.sh" \
    "$ROOT/scripts/verify/run.mjs" --tier full --exclude smoke,docker,coverage,audit
else
  node "$ROOT/scripts/verify/run.mjs" --tier full --exclude smoke,docker,coverage,audit
fi
