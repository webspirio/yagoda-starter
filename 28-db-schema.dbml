// Ягода CRM — схема БД (чернетка). Діаграма: 28-db-schema.drawio, стиль: 28-db-schema.md.
// Джерело правил — 26-rules-by-example.md; посилання «§N» у нотатках ведуть саме туди,
// «правка N» — у 26-правки-і-запитання.md.
//
// Це НЕ 27-entities.dbml: там інша модель (text-ключі, пари бізнес-дата/час, berries).
// Тут — uuid, timestamp і ціна дня журналом на трійці (день, точка, сорт).
//
// Конвенції, зафіксовані навмисно:
//   * гроші numeric(12,2), ціни за кг numeric(10,2), ваги numeric(10,2);
//   * знімок замість перерахунку: те, що надруковано на папері, не рухається (§2.7);
//   * сторно — це поля void_*, а не DELETE; виправлення — новий документ (§9.3);
//   * похідні суми (залишок, «Разом») НЕ зберігаються — їх рахують (§3.2);
//   * борг постачальника — РІЗНИЦЯ ДВОХ ІСТОРІЙ (Σ intakes − Σ payouts по людині), а не сума
//     відкритих квитанцій: таблиці розподілу виплат у схемі немає (рішення власника
//     04.09.2026, розгорнуто в Note suppliers).
//
// Іменування (перейменовано 02.09.2026, причини записані, щоб їх не «полагодили» назад):
//   * intakes, а НЕ receipts: «receipt» уже зайняте розпискою за ящики
//     (crate_issuances.receipt_no, §6.4). Два різні документи одним словом — гірше.
//     І не receptions: англійською це стійка або прийом-вечірка, не прийомка.
//   * crate_issuances, а НЕ crate_issues: «issue» першим значенням читається як
//     «проблема/тікет».
//   * intake_item_tare_types — у множині, як решта 16 таблиць, і повним іменем
//     звʼязки на tare_types.
//   * units скрізь, де лічильник: у чотирьох таблицях одне слово, і жодного `count`,
//     який у запиті читається як виклик функції.
//   * user_role = point_operator | network_owner, а НЕ point_manager | network_admin:
//     колишні значення називали людину НА ТОЧЦІ «менеджером», а керівника мережі —
//     «адміністратором». §10.1 знає рівно дві ролі: приймальник і керівник.
//   * grade_prices, а НЕ shift_product_settings і НЕ shift_grade_prices — ланцюжок двох
//     перейменувань. Перше: ключ ціни це СОРТ, не товар (§4.1), тому не «налаштування».
//     Друге (03.09.2026): ціну виставляють о 07:10, а зміну відкривають о 07:30 (§1) — ціна
//     не може мати NOT NULL shift_id. І UNIQUE(shift, сорт) забороняв ІСТОРІЮ, якої §4.2
//     вимагає дослівно: «записи не перетираються — додаються».
//   * cash_counts тримає ВСІ три моменти перерахунку (opening | midday | closing), а не
//     лише той, що серед дня: суми відкриття й закриття полями shifts дали б 8 колонок і
//     другий механізм для жесту, який §7.6 уже вимагає окремим документом.
//   * target_cash і target_crates (collection_points) — СВІДОМО числа на точці, а не
//     історія окремими таблицями (рішення власника 03.09.2026, скасовує попередню хвилю):
//     «наділ це лише показник, на який клієнт орієнтується всередині дня; в історії важливі
//     фінансові операції, видачі ящиків тощо, а наділ — орієнтир». Цільове значення не факт
//     про минуле, і зберігати його історію нема сенсу.
// Перегляд: dbdiagram.io або `npx @dbml/cli dbml2sql 28-db-schema.dbml --postgres`.

Project yagoda_crm {
  database_type: 'PostgreSQL'
  Note: 'Прийомка ягоди: мережа пунктів, зміна як робочий день точки, борг постачальника і ящики як завдаток.'
}

/* ------------------------------ enum-и ------------------------------ */

Enum user_role {
  network_owner
  point_operator
}

Enum supplier_kind {
  none
  wholesale
  farmer
}

Enum crate_issuance_mode {
  deposit
  receipt
}

Enum point_kind {
  reception
  base
}

Enum shift_status {
  open
  awaiting_explanation
  closed
}

Enum cash_book {
  berry
  crates
}

Enum cash_count_kind {
  opening
  midday
  closing
}

// Значення void ПРИБРАНО 03.09.2026, і повертати його не можна. Дві причини, обидві з цього
// самого файлу: конвенція в шапці каже «сторно — це поля void_*, а не DELETE», а §9.3 вимагає
// ОБОВʼЯЗКОВОЇ причини сторно, якої статус не несе (transfers має трійку voided_at /
// voided_by_user_id / void_reason). Тримати обидва представлення означало б два примірники
// одного факту — те саме, що Note cash_counts називає забороненим за побудовою. Наслідок для
// запитів названий там же: сторнований переказ відсіюється РЯДКОМ voided_at IS NULL, а не тим,
// що його статус перестав бути accepted.
Enum transfer_status {
  sent
  accepted
  disputed
}

/* --------------------------- мережа і люди --------------------------- */

Table users {
  id uuid [pk]

  first_name varchar [not null]
  last_name varchar [not null]
  login varchar [unique, not null]
  password_hash varchar [not null]

  role user_role [not null]

  collection_point_id uuid [ref: > collection_points.id]

  created_at timestamp [not null]
  updated_at timestamp [not null]

  Note: 'Вхід за login, не за e-mail (правка в діаграмі 03.09.2026): адреси в приймальників може не бути взагалі, а логін на точці — це те, що людина справді набирає. UNIQUE стоїть на login і ТІЛЬКИ на ньому: унікальний індекс по хешу пароля відхиляв би другого користувача з тим самим паролем, тобто сам факт збігу ставав би видимим ззовні. Поле зветься password_hash, а не password, бо назва — єдине місце, де схема каже, що зберігати треба хеш; §17.2 при цьому нагадує, що пароль, який звіряють на самій точці, не підтверджує нічого. Це поле скасувало рядок 28-tables.md «Пароля немає навмисно» — причина скасування за власником, тут записано лише сам факт.'
}

Table collection_points {
  id uuid [pk]

  name varchar [not null]

  kind point_kind [not null, default: 'reception']

  target_cash   numeric(12,2)
  target_crates int

  is_active boolean [not null, default: true]

  created_at timestamp [not null]
  updated_at timestamp [not null]

  Note: '§4.8 — склад це звичайний пункт прийому зі своєю, вищою ціною, якого жест «поставити всім» НЕ чіпає; §8.1 — переважують НА БАЗІ, і документ розрізняє пункт, ЗВІДКИ приїхала ягода, від бази, ДЕ зважували. Без kind ні одне, ні друге не виражається. target_cash і target_crates (повернено 03.09.2026, рішення власника): «наділ це лише показник, на який клієнт орієнтується всередині дня; в історії важливі фінансові операції, видачі ящиків тощо, а наділ — орієнтир» — тобто цільове значення НЕ факт про минуле, і зберігати його історію нема сенсу. Тому це числа на точці, а не окремі таблиці з effective_from. NOT NULL і default НЕ стоять свідомо: §6.9 вимагає «—» для точки без цільового значення, а не нуль («нуль стверджував би, що ящиків немає, тоді як ми просто не знаємо, скільки їх має бути»), і §7.10 — щоб точка без цільового значення каси взагалі не потрапляла в таблицю боргу мережі; default: 0 робив би «не задано» нерозрізненним від нуля і ламав обидві вимоги. Механічний наслідок відсутності effective_from: зміна цільового значення діє відразу на всі дні, включно з минулими, тому «не вистачає до цільового» за минулу дату рахується за поточним числом. Це прийнято свідомо: назад не гортають. target_crates порожній — це «не задано», а НЕ нуль; невстановлене цільове значення НЕ БЛОКУЄ видачу ящиків, лише показує попередження (правка 14 у 26-правки-і-запитання.md, яка скасовує пряму заборону з §9.1 «кнопка видачі неактивна» — забороняти видачу через порожній target_crates означало б відтворити скасовану заборону). Те саме для target_cash: точка без нього просто не потрапляє в таблицю боргу мережі (§7.10), а не рахується так, ніби борг нульовий. ЧОТИРИ ПРАВИЛА, ЯКІ ПРИЇХАЛИ СЮДИ РАЗОМ ІЗ ЧИСЛАМИ (перші три жили в Note прибраної crate_allotments і після її зникнення не мали в схемі жодного місця; перенесено 03.09.2026 тим самим ходом, яким сюди переїхала правка 14). ПЕРШЕ (§10.2): цільове значення змінює ЛИШЕ КЕРІВНИК; у приймальника цієї кнопки НЕ ІСНУЄ — не «є, але сіра». Різниця несуча: заблокована кнопка вчить шукати обхід, відсутня не вчить нічого; у коді це записано коментарем у PointCashPage.tsx, а в схемі — тільки тут. ДРУГЕ (§6.1): цільове значення, МЕНШЕ за те, що вже в людей і в дорозі, дозволене З ПОПЕРЕДЖЕННЯМ, а не забороною — цільове значення це управлінське рішення. Це той самий клас пастки, що й правка 14 вище: читач, який бачить голий nullable int, відтворить заборону, якої правило не просить. ТРЕТЄ: ЗАПИТАННЯ 12 не закрите — чи наділ розбитий за типами тари. Схема припускає, що НІ (§12.3 дефолт: ягоду не пересипають); якщо так — target_crates потребує розбиття (полем на тип або окремою таблицею), і тотожність 800 = 341 + 195 + 264 перестає бути тотожністю. У Note tare_types те саме запитання стоїть у вужчому формулюванні («чи Ящик і Чешка одна одиниця») — обидва боки того самого запитання, і закриються вони разом. ЧЕТВЕРТЕ, і його не називає жоден інший документ: разом із таблицями зникли АВТОР І ПРИЧИНА зміни цільового значення, які §6.1 показує у своєму ж прикладі («15.07.2026 цільове значення 600 → 800, керівник, причина: розширили точку»). set_by_user_id і reason жили в cash_floats/crate_allotments і більше не існують ніде: хто підняв наділ і чому — у схемі не зберігається. Це наслідок рішення власника (наділ — орієнтир, а не факт про минуле), а не недогляд, і він названий тут, щоб наступний читач не шукав цих полів деінде.'
}

Table shifts {
  id uuid [pk]

  collection_point_id uuid [not null, ref: > collection_points.id]

  opened_by_user_id uuid [not null, ref: > users.id]
  closed_by_user_id uuid [ref: > users.id]

  business_date date [not null]

  opened_at timestamp [not null]
  closed_at timestamp

  status shift_status [not null, default: 'open']

  explanation text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (collection_point_id) [unique]
    (collection_point_id, business_date)
  }

  Note: 'ЧАСТКОВИЙ унікальний індекс: UNIQUE (collection_point_id) WHERE closed_at IS NULL — DBML часткових індексів не виражає, тому в SQL його дописують руками. §7.8: дві відкриті зміни це дві книги на одну шухляду, і хто прорахувався, буде не видно. §10.3 — відкриває і закриває зміну ПРИЙМАЛЬНИК; §7.7 + правка 2 — при розбіжності закриває КЕРІВНИК, обовʼязково з explanation, і розбіжність у документі лишається, її не підганяють. Порогів «допустимої» розбіжності немає: не зійшлося на копійку — те саме, що на 350 ₴. Сум каси тут НЕМАЄ: усі три перерахунки лежать у cash_counts.'
}

/* ------------------------------ довідники ------------------------------ */

Table suppliers {
  id uuid [pk]

  collection_point_id uuid [not null, ref: > collection_points.id]

  first_name varchar [not null]
  last_name varchar [not null]

  phone varchar
  note text

  kind supplier_kind [not null, default: 'none']

  is_active boolean [not null, default: true]

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (collection_point_id, phone) [unique]
    (collection_point_id, last_name)
  }

  Note: '''
**БОРГ ПОСТАЧАЛЬНИКА — як він рахується.** Читати перед першим запитом до `intakes` і `payouts`.

### Сам запис

§3.9 — запис прибитий до ТОЧКИ: людина, яка возить на дві точки, заводиться на кожній окремо, і
борг з однієї не гаситься на іншій. §5.6 — видалення немає, тільки `is_active`. §5.7 + правка 8 —
`phone` null дозволено лише через явний чекбокс «без номеру телефону» на формі; окремого поля під
цей факт немає навмисно. Пошук за телефоном (правка 5) — звідси унікальність у межах точки. §5.4
і §5.5 (розпізнавання й обʼєднання дублікатів) скасовані правками 5 і 6, тому таблиць під них тут
НЕМАЄ.

**СЕЛА ТУТ НЕМАЄ** — ні полем, ні звʼязкою, і таблиці `villages` більше не існує (рішення власника
04.09.2026). Це скасовує §5.3 разом із його доказом (у робочій книзі клієнта одне село написане
чотирма способами: «копайгород» 571 рядок, «Копайгород» 175, «Копайгород » з пробілом 45, «Копай»)
і викреслює село з §2.1 крок ① та з картки §3.10. Наступному читачеві, який захоче «полагодити» це
назад текстовим полем `village`: саме текстове поле той доказ і описує.

### Борг = різниця двох історій

Борг НЕ є властивістю документа. Розподілу «яка виплата що закрила» не існує — його прибрано
04.09.2026 разом із таблицею `payout_allocations`. Лишилися дві історії й одна різниця:

```sql
SELECT s.id,
       COALESCE((SELECT SUM(i.amount) FROM intakes i
                  WHERE i.supplier_id = s.id AND i.voided_at IS NULL), 0)
     - COALESCE((SELECT SUM(p.amount) FROM payouts p
                  WHERE p.supplier_id = s.id AND p.voided_at IS NULL), 0) AS debt
  FROM suppliers s;
```

`supplier_id` уже означає точку (§3.9), тому окремо фільтрувати точку не треба й не можна. Фільтр
`voided_at IS NULL` стоїть на ОБОХ історіях, і забути його на будь-якій означає або гасити борг
грошима, яких не видали, або тримати борг за ягоду, якої не брали.

Полів `paid` / `debt` / `balance` немає ані тут, ані в `intakes`, і додавати їх не можна (§3.2:
поля «Залишок» не існує як поля вводу для ЖОДНОЇ ролі). Збережений кеш — рівно те місце, де в
робочій книзі клієнта рвався ланцюжок: **124 розриви з 1 473**.

«Разом» на прийомці (§3.1) — це той самий борг після проведення сьогоднішньої квитанції, а не
друге число. Стеля виплати лишається подвійною: `min(Разом, каса за ягоду)` (§3.5, §3.6).

### Чого більше немає — і це рішення, а не пропуск

- **Розподілу і FIFO** (§3.3): жодна виплата не памʼятає, яку саме дату вона закрила.
- **Недоплати, що осідає на сьогоднішній квитанції** (§3.4): осідати нема на чому.
- **Порядкового списку відкритих залишків** (§3.10) і статусів Paid / Partially Paid / Open.
  Картка показує ДВА ОКРЕМІ СПИСКИ — квитанції й виплати — і одне число під ними.
- **Розкладки «видано з каси» на «за сьогоднішню ягоду» і «за ягоду інших днів»** (§7.3,
  «Інваріант дня», [БР-18, ЗВ-06, КС-13]). Замість неї день показує ПРИРІСТ БОРГУ за точку:
  `Σ intakes дня − Σ payouts дня`.

Ціна названа вголос: на питання «а за що саме ви мені винні» система більше не відповідає рядком.
Вона відповідає двома списками, які людина звіряє сама.

### Мінус

Виплата обрізана стелею, тому до мінусу не доводить ніколи; сторно виплати борг лише підіймає.
ЄДИНИЙ шлях у мінус — сторно КВИТАНЦІЇ, на яку вже видали гроші. Воно ДОЗВОЛЕНЕ, з попередженням:
заборони немає, і інваріанта `борг >= 0` в цій схемі теж немає — обидва старі інваріанти були про
розподіл і зникли разом із ним.

Мінус гаситься САМ наступною здачею, бо «Разом» дорівнює балансу. Це частково повертає поведінку
§3.8, яку правка 4 скасувала словами «Немає переплати», — але тільки для мінусу, створеного сторно
квитанції, бо іншого шляху в мінус немає. Названо, не полагоджено.

### Стартового боргу немає

Борг існує рівно настільки, наскільки в базі є документи: нижньої межі по датах у нього немає і
бути не може (на відміну від каси, де межа — параметр застосунку `AppConfig.cashBookFrom`).
Механізму «вступний залишок» у схемі НЕМАЄ навмисно (рішення власника 04.09.2026): борг, набутий
до запуску, у систему не заводиться взагалі й закривається по паперу поза нею. Перший день роботи
показує всім нуль — це очікуваний стан, а не втрата даних.

### Історія нерухома, папір — ні

`intake.amount` і `payout.amount` після проведення не міняються НІКОЛИ (§2.7); на борг впливають
рівно поява документів і поля `void_*`. Стан на мить друку квитанції відновлюється лише
прокочуванням обох історій до тієї позначки часу, бо надруковані «Разом», «видано» і «залишок» не
зберігаються (§3.2). ВІДКРИТЕ, НАЗВАНЕ: після сторно папір у руках людини і база розходяться, і
жодне поле цього не тримає.
'''
}

Table products {
  id uuid [pk]

  name varchar [not null, unique]

  display_order int

  created_at timestamp [not null]
  updated_at timestamp [not null]

  Note: '§4.1 — ключ звітності. is_active тут НЕМАЄ навмисно (рішення власника 03.09.2026), і це не пропуск: видимість товару ВИВОДИТЬСЯ, а не зберігається. §4.1 дослівно — «Товар без жодного АКТИВНОГО сорту приймальнику не показується», тобто механізм уже є, а стан живе в product_grades.is_active. Там же стоїть і живий приклад: Кизил не має жодного сорту, тому веде в глухий кут — він невидимий не через вимкнення, а через відсутність сортів. У застосунку цього поля теж немає: Product має рівно два поля, id і name, і десять товарів прожили без прапорця. Два примірники одного факту в цьому проєкті заборонені, а другий примірник тут ще й створив би стан, на який не відповідає ЖОДНЕ правило: товар вимкнений, а сорт активний і має ціну дня. Зворотний стан (товар активний, усі сорти вимкнені) §4.1 закриває сам. tare_types і collection_points прапорець ЗБЕРІГАЮТЬ: для них is_active — єдиний спосіб сховати запис зі списку вибору, бо вивести їхню видимість нема з чого. Наступному читачеві, який побачить прапорець у чотирьох таблицях із шести: тут його немає з цієї причини, а не за недоглядом. Довідника сіл у цьому переліку більше немає — villages прибрано 04.09.2026 разом із самим полем села (див. Note suppliers).'
}

Table product_grades {
  id uuid [pk]

  product_id uuid [not null, ref: > products.id]

  name varchar [not null]
  // Наприклад:
  // 1 сорт
  // 2 сорт
  // Екстра

  display_order int

  is_active boolean [not null, default: true]

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (product_id, name) [unique]
  }

  Note: '§4.1 — ключ ціни це СОРТ, ключ звітності — товар. «ОПТ» серед прикладів НЕ СТОЇТЬ навмисно (рішення 02.09.2026): у 26-rules-by-example.md це слово трапляється в десяти рядках і ЖОДНОГО разу як сорт — тільки як маркер на людині, suppliers.kind = wholesale (§2.11). Сорт «ОПТ» із власною ціною дня дав би ту саму надбавку двічі: раз ціною дня, раз через intake_items.bonus, — і правило §2.11 «базова ціна від маркера не залежить ніколи» трималося б лише домовленістю. Твердження прийшло зі старої моделі (27-entities.dbml, berries.wholesale) і скасоване.'
}

Table tare_types {
  id uuid [pk]

  name varchar [not null, unique]

  weight_kg numeric(10,2) [not null]
  deposit_price numeric(12,2) [not null]

  is_crate boolean [not null, default: false]

  is_active boolean [not null, default: true]

  created_at timestamp [not null]
  updated_at timestamp [not null]

  Note: '§2.5 — вага тари підставляється сама. Обидва числа РЕДАГУЮТЬСЯ керівником, тому і intake_items.tare_weight_kg, і crate_issuances.deposit_per_unit є знімками (§2.7). is_crate — яка тара вважається «ящиком» для цільового значення й завдатків; ЗАПИТАННЯ 12 (чи «Ящик» і «Чешка» одна одиниця) не закрите.'
}

/* ------------------------------ ціни дня ------------------------------ */

Table grade_prices {
  id uuid [pk]

  business_date       date [not null]
  collection_point_id uuid [not null, ref: > collection_points.id]
  product_grade_id    uuid [not null, ref: > product_grades.id]

  base_price numeric(10,2) [not null]

  set_at         timestamp [not null]
  set_by_user_id uuid [not null, ref: > users.id]
  reason         text

  created_at timestamp [not null]

  indexes {
    (collection_point_id, business_date, product_grade_id, set_at)
  }

  Note: '§4.2 — кожна зміна ціни лягає ОКРЕМИМ записом із часом і автором; записи не перетираються, а додаються. Чинною є остання за set_at. UNIQUE тут НЕМАЄ навмисно: саме він у колишній shift_grade_prices забороняв історію. reason — «конкуренти підняли» (§4.2). Ключ — трійка (день, точка, сорт) з §2.8, а не (зміна, сорт): керівник ставить ціни о 07:10, приймальник відкриває зміну о 07:30 (§1), тому NOT NULL shift_id був неможливий. §4.1 — ключ ціни це СОРТ, ключ звітності — товар. §4.5 — сорт без ціни дня на прийомці не показується взагалі, тому ВІДСУТНІСТЬ рядка і є вимкненням: поля is_enabled немає, довговічне вимкнення тримає product_grades.is_active. operator_price_delta теж немає: §2.8 кладе надбавку НА РЯДОК (intake_items.bonus), а ціна дня в прийомці під замком — тримати дельту ще й тут означало б ту саму надбавку двічі, дослівно той аргумент, яким відкинуто сорт «ОПТ» у Note product_grades. ЦІНА РІШЕННЯ: intakes більше не має спільної зміни з ціною, тому «ціна тієї точки того дня» тримає застосунок, а не зовнішній ключ. Прийомка бере ціну ЗНІМКОМ у intake_items.price, тому §4.6 (раніші квитанції не перераховуються) тримається сам.'
}

/* --------------------- каса точки і перекази --------------------- */

Table cash_counts {
  id uuid [pk]

  shift_id uuid [not null, ref: > shifts.id]

  book cash_book       [not null]
  kind cash_count_kind [not null]

  counted_amount  numeric(12,2) [not null]
  expected_amount numeric(12,2) [not null]

  counted_by_user_id uuid [not null, ref: > users.id]
  counted_at timestamp [not null]

  created_at timestamp [not null]

  indexes {
    (shift_id, book, kind) [unique]
    (shift_id, counted_at)
  }

  Note: '''
**КАСА ТОЧКИ — як вона рахується.** Читати перед першим запитом про гроші точки.

Точки в цій таблиці немає — вона у `shifts`, і два примірники одного факту в цьому проєкті
заборонені за побудовою. `expected_amount` — **знімок** очікуваного на мить перерахунку: без
нього пізніша подія тихо переписала б учорашню розбіжність. Розбіжність = `counted − expected`
і НЕ зберігається; поля вводу для неї немає в жодної ролі (§7.7). Порогів «допустимої»
розбіжності немає взагалі.

`counted_by_user_id` — той, **хто натиснув**, а не той, хто відкривав зміну: §10.6 — «якщо касу
перерахує Марія, у документі перерахунку стоїть Марія, навіть якщо зміну відкривала Оксана».
Перерахунок нічого не виправляє і нічого не перетирає (§7.6) — робити його можна скільки
завгодно разів, звідси `midday` поза унікальним індексом. Сам індекс частковий:
`UNIQUE (shift_id, book, kind) WHERE kind <> 'midday'` — DBML цього не виражає, у SQL дописують
руками.

### ДВІ КНИГИ, ЯКІ НЕ ПОЗИЧАЮТЬ ОДНА В ОДНОЇ

Термінологія правок: каса на ягоду — просто **каса**, усе про ящики — **завдатки**. Правка 1
знімає формулювання §1 «лежать в одній шухляді»: фізично шухляда одна, книг **дві**, і
`cash_book` робить це видимим у кожному запиті — суму без `GROUP BY cash_book` непомітно не
напишеш.

**Книга ягоди** на точці. НИЖНЬОЇ МЕЖІ ПО ДАТАХ У СХЕМІ НЕМАЄ: день, з якого ведеться касова
книга, — це параметр застосунку (`AppConfig.cashBookFrom` у `src/lib/types.ts`), а не поле
цієї схеми, і поля з таким іменем тут не було ніколи. `D` у формулі — верхня межа, не нижня.
Для книги ящиків нижня межа названа вголос і лишається (§7.5, «від першої видачі»).

```sql
+ Σ transfers, у яких accepted_date <= D і voided_at IS NULL:
      status = 'accepted'                            -> cash
      status = 'disputed' AND resolved_at IS NOT NULL -> resolved_cash
- Σ payouts.amount, де payouts -> shifts дає цю точку і shifts.business_date <= D
      -- ВКЛЮЧНО ЗІ СТОРНОВАНИМИ
+ Σ payouts.amount, у яких return_settled_at <= D
```

**Сторновані ПЕРЕКАЗИ відсіюються рядком `voided_at IS NULL`, а не статусом.** Статусу `void`
в `transfer_status` немає (три значення: `sent | accepted | disputed`), тому сторнований
переказ лишається зі своїм `status = 'accepted'` і без цього фільтра далі додавав би гроші в
касу точки. Фільтр стоїть так само явно, як у книзі ящиків нижче, і з тієї самої причини.

**Сторновані виплати з формули каси НЕ відсіюються, і це протилежно до формули боргу.** Борг
(Note `suppliers`) вимагає відсіяти `voided_at IS NOT NULL`, бо гроші «не видали».
Каса вимагає протилежного: гроші **фізично вийшли з шухляди** і повертаються лише внесенням,
тобто рядком `payouts.return_settled_at`. Один і той самий `voided_at` у двох запитах
читається по-різному — інакше сторно стає способом красти (§9.3).

**Книга ящиків**, від першої видачі, без нижньої межі по датах (§7.5):

```sql
+ Σ crate_issuances.deposit_taken   (voided_at IS NULL)
- Σ crate_returns.deposit_refund    (voided_at IS NULL)
      -- обидві дають точку через shifts, як і виплати
```

**Відкрите, і не полагоджене:** для ящиків сторно трактується протилежно до виплати —
відсторнована видача перестає давати гроші в касу, хоч завдаток фізично в шухляді, і жодного
очікуваного повернення під це немає. Правила такого випадку не описують: §9.3 знає очікуване
повернення лише для виплати, а §9.4 дозволяє сторнувати ящиковий документ тільки керівнику й
забороняє сторно видачі, на яку вже лягло повернення. Асиметрія свідома й названа.

**Що касу НЕ рухає:** витрати дня (§7.2 — «каса тільки ягодами, ті всі різні розтрати я передаю
окремо»), ручна видача «не за ягоду» та інкасація — їх у системі немає взагалі (§7.3, список
джерел закритий). Таблиці рухів каси теж немає: правка 9 — «система рахує загальну суму в касі
за допомогою денних транзакцій». Збережений залишок заборонений тією ж причиною, що й
`remaining` у `intakes` (§3.2).
'''
}

Table transfers {
  id uuid [pk]

  collection_point_id uuid [not null, ref: > collection_points.id]

  cash   numeric(12,2) [not null]
  crates int [not null]

  carrier varchar [not null]

  sent_by_user_id uuid [not null, ref: > users.id]
  sent_at timestamp [not null]

  status transfer_status [not null, default: 'sent']

  accepted_by_user_id uuid [ref: > users.id]
  accepted_date date
  accepted_at   timestamp

  reported_cash   numeric(12,2)
  reported_crates int
  dispute_note    text

  resolved_cash   numeric(12,2)
  resolved_crates int
  resolved_by_user_id uuid [ref: > users.id]
  resolved_at timestamp

  correction_of_transfer_id uuid [ref: > transfers.id]

  voided_at timestamp
  voided_by_user_id uuid [ref: > users.id]
  void_reason text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (collection_point_id, accepted_date)
    (status)
  }

  Note: '§7.9 — переказ несе гроші й порожні ящики однією поїздкою. carrier це ТЕКСТ, не обліковий запис: «Іван, Ducato» підписує в зошиті перевізник, і без перевізника документ не проводиться. Рейс ідентифікують ДАТОЮ і ПЕРЕВІЗНИКОМ, а не номером: §7.9 описує переказ повністю і номера не згадує жодного разу, а паперового двійника немає — перевізник підписує в зошиті. У стані sent не рухається НІЧОГО: ні каса точки, ні цільове значення ящиків. accepted_date — ДЕНЬ ПРИЙНЯТТЯ, і саме ним зараховуються гроші та ящики: машина виїхала ввечері, точка порахувала вранці, і гроші не мають лежати в касі за день, коли їх фізично не було. Натиснути «Прийняв» може ТІЛЬКИ точка (§10.3) — керівник не може зробити це за неї. reported_* і dispute_note — те, що точка нарахувала при «Не сходиться»: це ІНФОРМАЦІЯ для керівника, у формули не входить ніколи. resolved_* — відповідь на ЗАПИТАННЯ 4 і несуче поле: §7.9 крок 4б каже, що після підтвердження у формулу потрапляє число, яке вказує КЕРІВНИК, закриваючи спір; без цієї пари єдиним місцем для того числа стало б редагування cash, тобто тихе переписування проведеного документа. correction_of_transfer_id — виправлення це НОВИЙ документ. ІНВАРІАНТ ЗАСТОСУНКУ, якого схема не перевіряє: accepted_* заповнені рівно при status = accepted, reported_* і dispute_note — лише при disputed, resolved_* — лише коли спір закрито; CHECK під це не написаний навмисно, бо стан документа міняється в часі й проміжні комбінації існують. §9.4 — сторнує переказ тільки керівник; точка сторнувати не може. СТОРНО ТУТ — ТРІЙКА void_*, А НЕ СТАТУС: у transfer_status рівно три значення (sent | accepted | disputed), значення void прибрано 03.09.2026, бо §9.3 вимагає обовʼязкової ПРИЧИНИ сторно, якої статус не несе, а конвенція в шапці файла каже те саме загалом. Механічний наслідок: сторнований переказ лишається зі status = accepted, тому кожен запит про касу мусить відсіяти voided_at IS NOT NULL сам — формула в Note cash_counts робить це явно, і без того рядка сторнований переказ далі додавав би гроші в касу точки. Борг мережі перед точкою (§7.10) НЕ зберігається: це collection_points.target_cash мінус каса точки.'
}

/* ------------------------- прийомка ягоди ------------------------- */

Table intakes {
  id uuid [pk]

  code varchar [not null, unique]

  shift_id uuid [not null, ref: > shifts.id]
  supplier_id uuid [not null, ref: > suppliers.id]

  amount numeric(12,2) [not null]

  received_by_user_id uuid [not null, ref: > users.id]

  voided_at timestamp
  voided_by_user_id uuid [ref: > users.id]
  void_reason text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (supplier_id, created_at)
    (shift_id)
  }

  Note: '§2.3 — один візит із кількома сортами це ОДИН документ із кількома рядками (стеля 5), а не кілька прийомок; amount = Σ intake_items.amount, те саме число, що надруковане на папері. Точка й бізнес-дата беруться зі зміни, автор транзакції — окремо (правка 16): хто відкрив зміну і хто провів квитанцію, це різні люди. Виплачене й залишок ТУТ НЕ ЗБЕРІГАЮТЬСЯ (§3.2), і з 04.09.2026 залишку ОКРЕМОЇ КВИТАНЦІЇ не існує взагалі: борг це різниця двох історій по людині, а не сума відкритих квитанцій, тому питання «скільки лишилося за цією квитанцією» більше не має відповіді ні в схемі, ні на екрані. amount після проведення не міняється НІКОЛИ — на борг впливають рівно поява документів і поля void_*. §9.3 — сторно повне, з обовʼязковою причиною, документ лишається в журналі назавжди; сторно квитанції ЄДИНИЙ спосіб зробити борг відʼємним, і воно дозволене з попередженням. Як рахується борг — розгорнута Note таблиці suppliers.'
}

Table intake_items {
  id uuid [pk]

  intake_id uuid [not null, ref: > intakes.id]

  item_order int [not null]

  product_grade_id uuid [not null, ref: > product_grades.id]

  gross_kg numeric(10,2) [not null]
  pallet_kg numeric(10,2) [not null, default: 0]
  tare_weight_kg numeric(10,2) [not null]
  net_kg numeric(10,2) [not null]

  price numeric(10,2) [not null]
  bonus numeric(10,2) [not null, default: 0]
  amount numeric(12,2) [not null]

  indexes {
    (intake_id, item_order) [unique]
  }

  Note: '§2.4 — піддон віднімається ПЕРШИМ, тара другою: net = (gross − pallet) − tare_weight. Поля net людина не вводить ніколи. §2.8 — price це ЗНІМОК ціни дня (grade_prices.base_price, чинної на мить прийомки, тобто останньої за set_at); надбавка живе ОКРЕМО, у bonus НА РЯДКУ, а не на людині: одна людина може здати два сорти з різними надбавками, і від’ємний bonus це мʼята чи цвіла ягода. §2.9 — межа мережі ±30 ₴/кг обрізає bonus, але самої межі в цій схемі поки НЕМАЄ де зберігати.'
}

Table intake_item_tare_types {
  item_id uuid [not null, ref: > intake_items.id]
  tare_type_id uuid [not null, ref: > tare_types.id]

  units int [not null]

  indexes {
    (item_id, tare_type_id) [pk]
  }

  Note: '§2.6 — ящики В КВИТАНЦІЇ (вага, що знімається) і ящики НА РУКАХ (майно, crate_issuances) ніде не складаються в одне.'
}

/* --------------------------- виплати --------------------------- */

Table payouts {
  id uuid [pk]

  code varchar [not null, unique]

  shift_id uuid [not null, ref: > shifts.id]
  supplier_id uuid [not null, ref: > suppliers.id]

  amount numeric(12,2) [not null]

  paid_by_user_id uuid [not null, ref: > users.id]

  voided_at timestamp
  voided_by_user_id uuid [ref: > users.id]
  void_reason text

  return_settled_at         timestamp
  return_settled_by_user_id uuid [ref: > users.id]
  return_note               text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (supplier_id, created_at)
  }

  Note: '§3.5 — видати більше за «Разом» неможливо, сума обрізається; від’ємного залишку виплата не створює. §3.6 — стеля подвійна: min(Разом, каса за ягоду). §3.7 — дозволена будь-яка сума від 0 до «Разом». §9.3 — сторно виплати НЕ повертає готівку в касу само («каса НЕ виросла на 8 000… інакше сторно стає способом красти»): доки return_settled_at порожній, каса точки лишається зменшеною на суму виплати. Заповнення return_settled_at і є фізичним внесенням грошей назад; сума НЕ дублюється — вона завжди дорівнює payouts.amount. Форма трійки навмисно та сама, що в void_*: це другий у схемі клас полів, які дописують ПІСЛЯ проведення документа. Виплата не «закриває» жодної конкретної квитанції: розподілу немає, і «Разом» дорівнює просто боргу людини на цю мить. Як рахується борг — розгорнута Note таблиці suppliers.'
}

/* ---------------------------- ящики ---------------------------- */

Table crate_issuances {
  id uuid [pk]

  shift_id uuid [not null, ref: > shifts.id]
  supplier_id uuid [not null, ref: > suppliers.id]

  units int [not null]

  mode crate_issuance_mode [not null]

  deposit_per_unit numeric(12,2) [not null, default: 0]
  deposit_taken numeric(12,2) [not null, default: 0]

  receipt_no varchar

  issued_by_user_id uuid [not null, ref: > users.id]

  voided_at timestamp
  voided_by_user_id uuid [ref: > users.id]
  void_reason text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (supplier_id, created_at)
  }

  Note: '§6.2 — спосіб система підставляє сама (до 50 завдаток, від 51 розписка), приймальник може перемкнути: екран перепитає, але не заблокує. §6.3 — завдаток = units × deposit_per_unit лягає в КАСУ ЗА ЯЩИКИ. §6.4 — за розписку грошей немає взагалі (deposit_* = 0, на екрані «—», не «0,00»), номер розписки вписується руками; ЗАПИТАННЯ 2 (генерувати чи вводити) не закрите. §2.7 — deposit_per_unit це ЗНІМОК: зміна ціни ящика зі 120 на 130 не переписує липневу видачу. §9.4 — ящиковий документ сторнує ТІЛЬКИ керівник.'
}

Table crate_returns {
  id uuid [pk]

  shift_id uuid [not null, ref: > shifts.id]
  supplier_id uuid [not null, ref: > suppliers.id]

  units int [not null]

  deposit_refund numeric(12,2) [not null, default: 0]

  accepted_by_user_id uuid [not null, ref: > users.id]

  voided_at timestamp
  voided_by_user_id uuid [ref: > users.id]
  void_reason text

  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (supplier_id, created_at)
  }

  Note: '§6.5 — повернення часткове дозволене, повернути більше, ніж узято, не можна. Правка 15: якщо привезли 25 при виданих 20 — у систему йдуть тільки 20, решта 5 це обмін порожніми на ящики постачальника, і в обліку його немає. §6.7 — гроші виходять із каси за ящики; порожня каса за ягоду цьому не заважає, а порожня каса за ящики БЛОКУЄ повернення.'
}

Table crate_return_allocations {
  return_id uuid [not null, ref: > crate_returns.id]
  issuance_id uuid [not null, ref: > crate_issuances.id]

  units int [not null]
  per_unit numeric(12,2) [not null]
  amount numeric(12,2) [not null]

  indexes {
    (return_id, issuance_id) [pk]
    (issuance_id)
  }

  Note: '§6.5 — гаситься найстаріша видача першою, і per_unit береться З ТІЄЇ видачі, а не з довідника: людина, яка брала по 120 і по 130, отримує назад саме те, що платила. Приймальник при цьому нічого не питає і не обирає. §6.6 — розписка й завдаток не змішуються навіть у поверненні. §9.3 — видачу, на яку вже лягло повернення, сторнувати не можна, поки не сторновано повернення.'
}
