{
  "compilerOptions": {
    "module": "commonjs",
    // bundler, not node10 (removed in TS 7) or node16 (would move Jest onto
    // ESM): it is the one mode TS 6 and TS 7 both accept beside commonjs, and
    // like Node's require() it reads exports maps' `require` condition without
    // demanding file extensions.
    "moduleResolution": "bundler",
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "sourceMap": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    // TypeORM entities and class-validator DTOs are populated by the framework, not in constructors.
    "strictPropertyInitialization": false,
    "types": ["jest", "node"]
  }
}
