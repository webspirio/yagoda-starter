{
  "name": "web-starter",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "shadcn": "^4.18.0",
    "turbo": "^2"
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "db:reset": "docker compose down -v && docker compose up -d postgres redis"
  }
}
