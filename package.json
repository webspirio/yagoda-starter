{
  "name": "web-starter",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "shadcn": "^4.18.0",
    "turbo": "^2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck && tsc -p tsconfig.scripts.json",
    "format": "prettier --write .",
    "db:reset": "docker compose down -v && docker compose up -d postgres redis",
    "db:seed": "npm run seed:dev -w backend",
    "test:verify": "node --test --test-concurrency=1 'scripts/verify/**/*.test.mjs'",
    "test:files": "node scripts/verify/checks/test-glob-parity.mjs",
    "memo": "node scripts/verify/checks/memo-drift.mjs",
    "secrets": "node scripts/verify/checks/secret-boundary.mjs",
    "seam": "node scripts/verify/checks/seam-boundary.mjs",
    "lint:exempt": "node scripts/verify/ratchets/lint-exempt.mjs",
    "ratchet:money": "node scripts/verify/ratchets/money-rounding.mjs",
    "ratchet:persist": "node scripts/verify/ratchets/persist-boundary.mjs",
    "migrations:check": "node scripts/verify/checks/migration-invariants.mjs",
    "verify": "node scripts/verify/run.mjs --tier fast",
    "verify:full": "node scripts/verify/run.mjs --tier full",
    "verify:ci": "node scripts/verify/run.mjs --tier full --no-skip"
  }
}
